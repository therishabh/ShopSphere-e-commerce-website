{
  "name": "shopsphere",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-vendor e-commerce backend",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d mongo redis",
    "db:down": "docker compose down",
    "db:migrate": "node scripts/db.js migrate",
    "db:status": "node scripts/db.js status",
    "db:seed": "node scripts/db.js seed",
    "db:reset": "node scripts/db.js reset"
  },
  "dependencies": {
    "argon2": "0.45.1",
    "connect-redis": "10.0.0",
    "dotenv": "18.0.8",
    "express": "5.3.0",
    "express-session": "1.19.0",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "mongoose": "9.11.2",
    "pino": "10.4.0",
    "redis": "6.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "jest": "30.5.2",
    "prettier": "3.9.10",
    "supertest": "7.3.1"
  }
}
