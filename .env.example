# Local development ke liye: isko `.env` naam se copy karo (`cp .env.example .env`). `.env` git mein jaati nahi.
# Yahan kabhi real secrets/passwords mat likhna; ye file repo mein commit hoti hai.
# Naya variable add karo to src/config/env.js ke schema mein bhi add karo (wahi isse validate karta hai).

# development | test | production. Behaviour (jaise teaching examples ka mount hona) isse badalta hai.
NODE_ENV=development
# Server kis address par sunega. 127.0.0.1 = sirf apni machine; Docker/server par 0.0.0.0 chahiye hota hai.
HOST=127.0.0.1
# Server ka port (0 se 65535). 0 = OS koi free port de.
PORT=3000
# Logs kitne detailed hon: trace | debug | info | warn | error | fatal | silent. (tests mein default 'silent')
LOG_LEVEL=info
