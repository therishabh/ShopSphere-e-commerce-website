# Local development ke liye: isko `.env` naam se copy karo (`cp .env.example .env`). `.env` git mein jaati nahi.
# Yahan kabhi real secrets/passwords mat likhna; ye file repo mein commit hoti hai.
# Naya variable add karo to src/config/env.js ke schema mein bhi add karo (wahi isse validate karta hai).

# development | test | production. Behaviour (jaise teaching examples ka mount hona) isse badalta hai.
NODE_ENV=development
# Server kis address par sunega. 127.0.0.1 = sirf apni machine; Docker/server par 0.0.0.0 chahiye hota hai.
HOST=127.0.0.1
# Server ka port (0 se 65535). 0 = OS koi free port de.
PORT=3000
# Logs kitne detailed hon: trace | debug | info | warn | error | fatal | silent. (tests mein default 'silent')
LOG_LEVEL=info

# MongoDB connection string. Local ke liye: `npm run db:up` (Docker, single-node replica set) chalao, phir ye URI kaam karti hai.
# `replicaSet=rs0` transactions ke liye zaruri hai; `directConnection=true` local single-node ke liye.
# Local container mein auth band hai (sirf 127.0.0.1 par). Production mein authenticated cluster ki URI secret manager/env se do
# (required). Isko kabhi log/commit mat karo.
MONGODB_URI=mongodb://127.0.0.1:27017/shopsphere?replicaSet=rs0&directConnection=true
# Ek app instance ke max database connections (default 10).
DB_POOL_MAX=10

# --- Authentication
# Access token (JWT) sign karne ka secret (>= 32 chars). Banao: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Khaali chhodo to dev mein har run par random secret banta hai (restart par purane tokens invalid). Production mein required.
# AUTH_JWT_SECRET=
# Frontend ka URL: email links (verify/reset) isse bante hain. Production mein https:// required.
APP_BASE_URL=http://localhost:3000
# Access token ki umar (seconds, 60..3600) aur refresh token ki umar (din, 1..90).
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Optional, sirf `npm run db:seed` ke liye: seed users (@shopsphere.test) ko ye password (>= 12 chars) milta hai. Source mein koi password nahi.
# SEED_PASSWORD=
